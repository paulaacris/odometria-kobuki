<launch>
  <!-- Apartat 5 [P]. Rectes repetides amb soroll a l'emulador + registre.
       Calibracio nominal a proposit: l'unica font d'error que s'estudia es
       l'aleatoria. -->
  <arg name="soroll"      default="0.02"/>   <!-- sigma de ~soroll_relatiu -->
  <arg name="repeticions" default="20"/>

  <include file="$(find pl1_cognom)/launch/odometria.launch">
    <arg name="calibracio" value="nominal"/>
    <arg name="metode"     value="punt_mig"/>
    <arg name="soroll"     value="$(arg soroll)"/>
  </include>

  <node pkg="pl1_cognom" type="executor_recorregut.py" name="executor_recorregut"
        output="screen">
    <rosparam command="load" file="$(find pl1_cognom)/config/executor.yaml"/>
    <param name="tipus"       value="recta"/>
    <param name="repeticions" value="$(arg repeticions)"/>
    <remap from="odom_propi" to="/odom_propi"/>
  </node>

  <node pkg="pl1_cognom" type="registre_csv.py" name="registre_csv" output="screen">
    <rosparam param="topics_odom">["/odom_propi", "/odom"]</rosparam>
    <param name="directori" value="$(find pl1_cognom)/resultats/incertesa_$(arg soroll)"/>
  </node>
</launch>
