<launch>
  <!-- Apartat 4 [P]. Sistema base amb la calibracio triada + quadrats + registre. -->
  <arg name="calibracio"  default="nominal"/>   <!-- nominal | fabrica | calibrat -->
  <arg name="sentit"      default="ccw"/>       <!-- cw | ccw -->
  <arg name="repeticions" default="5"/>         <!-- diap. 29 -->
  <arg name="metode"      default="punt_mig"/>

  <include file="$(find pl1_oliver)/launch/odometria.launch">
    <arg name="calibracio" value="$(arg calibracio)"/>
    <arg name="metode"     value="$(arg metode)"/>
  </include>

  <node pkg="pl1_oliver" type="executor_recorregut.py" name="executor_recorregut"
        output="screen">
    <rosparam command="load" file="$(find pl1_oliver)/config/executor.yaml"/>
    <param name="tipus"       value="quadrat"/>
    <param name="sentit"      value="$(arg sentit)"/>
    <param name="repeticions" value="$(arg repeticions)"/>
    <remap from="odom_propi" to="/odom_propi"/>
  </node>

  <node pkg="pl1_oliver" type="registre_csv.py" name="registre_csv" output="screen">
    <rosparam param="topics_odom">["/odom_propi", "/odom"]</rosparam>
    <param name="directori"
           value="$(find pl1_oliver)/resultats/umbmark_$(arg calibracio)_$(arg sentit)"/>
  </node>
</launch>
